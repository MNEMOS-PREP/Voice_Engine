# ── Python ───────────────────────────────────────────────────────────────
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# ── Node ─────────────────────────────────────────────────────────────────
node_modules/
dist/
.vite/
*.tsbuildinfo

# ── Local data & secrets ─────────────────────────────────────────────────
*.db
*.sqlite3
.env
.env.*
!.env.example

# Real credentials. The committed template with dummy values, and the list of
# what each key buys you, is required_keys.txt - keep the two in step.
keys.txt

# Launcher bookkeeping: one PID file per running service. Machine-local by
# definition.
.run/

# The server voice's line cache (tts.py): regenerated on demand.
.tts_cache/

# ── Interview data ───────────────────────────────────────────────────────
# Transcripts, session exports and any audio from a session are a real
# student's words. Local dev databases are already covered by *.db above; this
# covers the exports and recordings that are not. They do not go in git, ever.
session_exports/
recordings/
*.wav
*.mp3
*.m4a
*.webm

# ── Editors / OS ─────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

# Day 6: the WER runner's downloaded audio and transcripts
research/wer/cache/
research/lexicon/*.log
research/wer/*.log
# Spoken answers kept with consent (FR-11.19) - never committed
Backend/.kept_audio/

# The face builder (scripts/build_face.py): LAM checkout, weights and its venv.
# Gigabytes, rebuilt by the script; never committed.
.face_builder/

# Built heads (scripts/make_faces.py): 4 MB each, rebuilt from scripts/faces/portraits.json.
Backend/backend_M11_Voice_Engine/faces/*.zip
